# private/ guarda estado de servidor y datos personales. Nunca se sirve.
#
# El .htaccess de la raiz puede taparlo, pero esa regla vive en OTRO fichero: una
# migracion de hosting, un AllowOverride distinto o un despliegue parcial la dejan
# fuera y la carpeta queda publicada sin que nadie se entere. Esta viaja con ella.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
