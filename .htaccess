Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set X-Robots-Tag "noindex, nofollow"
  # HSTS: activar solo cuando el dominio definitivo tenga HTTPS estable
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── URLs limpias: /musica en vez de /musica.html (norma de agencia) ──
  # Solo raíz y solo GET a propósito: api/ son endpoints con POST y un 301
  # convierte un POST en GET — ahí rompería los formularios. El login del
  # panel también hace POST a panel-login.php: la condición =GET lo respeta.
  # Patrón calcado del .htaccess de SumbaHills (misma norma, ya en producción).

  # 1) La URL con extensión redirige a la limpia: una sola URL por página.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} "\s/+index\.html[\s?]" [NC]
  RewriteRule ^ / [R=301,L,NE]

  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} "\s/+([^/\s?]+?)\.(html|php)[\s?]" [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 2) La URL limpia sirve el fichero real sin que el navegador vea la extensión.
  #    ^([^/.]+)$ = solo raíz y sin puntos: robots.txt y assets no entran.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/.]+)$ $1.html [L]
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^/.]+)$ $1.php [L]
</IfModule>

# Carpetas privadas: refuerzo desde la raíz (guardado/ y config/ ya llevan su
# propio .htaccess con Require all denied, pero este fichero SÍ está versionado
# y vuelve con cada deploy — a SumbaHills un deploy le repuso la carpeta sin
# su .htaccess interno y sirvió leads en abierto, 27-jul-2026).
RedirectMatch 404 (?i)/\.git
RedirectMatch 404 (?i)/(guardado|config|Backups?)/

# Bloquear ficheros que nunca deben servirse
<FilesMatch "(^\.|\.(md|sql|log|bak)$)">
  Require all denied
</FilesMatch>
